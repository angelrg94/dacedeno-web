{
  "name": "angular-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prepare:brand": "node scripts/prepare-brand-assets.mjs",
    "test": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format:check": "prettier --check src scripts e2e playwright.config.ts *.json",
    "test:e2e": "playwright test",
    "check:release": "node --experimental-strip-types scripts/release-check.mjs"
  },
  "private": true,
  "packageManager": "npm@11.5.1",
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/platform-server": "21.2.23",
    "@angular/router": "21.2.23",
    "@angular/ssr": "21.2.24",
    "@fontsource-variable/bricolage-grotesque": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.2",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vitest": "4.0.8",
    "vite": "7.3.6"
  },
  "engines": {
    
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  }
}
