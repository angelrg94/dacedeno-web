{
  "name": "angular-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prepare:brand": "node scripts/prepare-brand-assets.mjs",
    "test": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format:check": "prettier --check src scripts e2e playwright.config.ts *.json",
    "test:e2e": "playwright test",
    "check:release": "node --experimental-strip-types scripts/release-check.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/ssr": "22.0.9",
    "@fontsource-variable/bricolage-grotesque": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.9",
    "@angular/cli": "22.0.9",
    "@angular/compiler-cli": "22.0.8",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.2",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "sharp": "0.35.4",
    "typescript": "6.0.2",
    "vitest": "4.0.8",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
